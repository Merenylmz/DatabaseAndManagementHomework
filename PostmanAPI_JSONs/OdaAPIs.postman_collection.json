{
  "info": {
    "name": "Oda",
    "description": "Oda tipi, oda, sezon fiyatı ve boş oda arama uçları. Önce Giriş isteğini gönderin, token otomatik kaydedilir.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "url",
      "value": "http://localhost:3002/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Giriş",
      "item": [
        {
          "name": "Giriş (yönetici)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{url}}/auth/giris",
              "host": [
                "{{url}}"
              ],
              "path": [
                "auth",
                "giris"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin1@otel.com\",\n  \"sifre\": \"personel123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gelen token'ı koleksiyon değişkenine kaydet, diğer istekler bunu kullanır",
                  "const cevap = pm.response.json();",
                  "if (cevap.token) pm.collectionVariables.set(\"token\", cevap.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
