{
  "info": {
    "name": "Rezervasyon ve Rapor",
    "description": "Rezervasyon, oda durumu, aylık rapor ve işlem geçmişi uçları. Önce uygun Giriş isteğini gönderin, token otomatik kaydedilir. Misafir uçları için önce auth/kayit ile bir misafir hesabı açın.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "url",
      "value": "http://localhost:3002/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Giriş",
      "item": [
        {
          "name": "Giriş (yönetici)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{url}}/auth/giris",
              "host": [
                "{{url}}"
              ],
              "path": [
                "auth",
                "giris"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin1@otel.com\",\n  \"sifre\": \"personel123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gelen token'ı koleksiyon değişkenine kaydet, diğer istekler bunu kullanır",
                  "const cevap = pm.response.json();",
                  "const token = cevap.token || (cevap.data && cevap.data.token);",
                  "if (token) pm.collectionVariables.set(\"token\", token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Giriş (resepsiyon)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{url}}/auth/giris",
              "host": [
                "{{url}}"
              ],
              "path": [
